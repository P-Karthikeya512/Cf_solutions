#include <bits/stdc++.h>
using namespace std;
 
void fastio() {
    ios::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);
}
 
void solve() {
    int n;
    cin >> n;
    vector<vector<int>> adj(n + 1);
    for (int i = 0; i < n - 1; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }
    vector<int> given(n), pos(n + 1);
    for (int i = 0; i < n; i++) {
        cin >> given[i];
        pos[given[i]] = i;
    }
    if (given[0] != 1) {
        cout << "No
";
        return;
    }
    for (int u = 1; u <= n; u++) {
        sort(adj[u].begin(), adj[u].end(),[&](int a, int b) { return pos[a] < pos[b]; });
    }
    vector<int> order;
    vector<char> vis(n + 1, false);
    queue<int> q;
    q.push(1);
    vis[1] = true;
    while (!q.empty()) {
        int u = q.front(); q.pop();
        order.push_back(u);
        for (int v : adj[u]) {
            if (!vis[v]) {
                vis[v] = true;
                q.push(v);
            }
        }
    }
    cout << (order == given ? "Yes
" : "No
");
    return;
}
 
int32_t main() {
    fastio();
    int t = 1;
    while (t--) {
        solve();
    }
    return 0;
}