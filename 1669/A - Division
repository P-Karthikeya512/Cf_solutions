#include<bits/stdc++.h>
using namespace std;
 
void fast(){
    ios::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);
}
 
void solve(){
  int n;
  cin >> n;
  if(n <= 1399) cout << "Division 4
";
  else if(n >= 1400 && n <= 1599) cout << "Division 3
";
  else if(n >= 1600 && n <= 1899) cout << "Division 2
";
  else cout << "Division 1
";
}
 
int main(){
    fast();
    int t;
    cin >> t;
    while(t--) solve();
    return 0;
}