void fastio()
{
    ios::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);
}
 
void solve()
{
    int x, n;
    cin >> x >> n;
    set<int> fac;
    for (int i = 1; i * i <= x; i++)
    {
        if (x % i == 0)
        {
            fac.insert(i);
            fac.insert(x / i);
        }
    }
    vi fc(fac.begin(), fac.end());
    int lo = 0, hi = fc.size() - 1, ans;
    while (lo <= hi)
    {
        int mid = lo + (hi - lo) / 2;
        if (fc[mid] * n <= x)
        {
            ans = mid;
            lo = mid + 1;
        }
        else
            hi = mid - 1;
    }
    cout << fc[ans];
    endl;
    return;
}
 
int32_t main()
{
    fastio();
    int t;
    cin >> t;
    while (t--)
    {
        solve();
    }
    return 0;
}