#include<bits/stdc++.h>
using namespace std;
 
int main(){
    ios::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);
    int t;
    cin >> t;
    while(t--){
        int x,ans=0,y=0;
        cin >> x;
        map<int,int>m;
        for(int i=1;i<x;i++){
            m[i]=gcd(x,i)+i;
        }
        for(auto it = m.begin();it!=m.end();++it){
            if(it->second <= x && it->second > ans) {ans=it->second;y=it->first;}
        }
        cout << y << endl;
    }
    return 0;
}