#include<bits/stdc++.h>
using namespace std;
 
int main(){
    ios::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);
    int t;
    cin >> t ;
    while(t--){
        int n,sum=0;
        cin >> n;
        while(n!=0){
            sum+=(n%10);
            n=n/10;
        }
        cout << sum << endl;
    }
    return 0;
}