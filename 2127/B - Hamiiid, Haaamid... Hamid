#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;
 
void solve() {
    int n, x;
    cin >> n >> x;
    string s;
    cin >> s;
    x--;
    int left_wall = -1, right_wall = -1;
    for (int i = x - 1; i >= 0; --i) {
        if (s[i] == '#') {
            left_wall = i;
            break;
        }
    }
    for (int i = x + 1; i < n; ++i) {
        if (s[i] == '#') {
            right_wall = i;
            break;
        }
    }
    int ans = 1;
    if (left_wall == -1 && right_wall == -1) ans += 0;
    else if (left_wall == -1) ans += min(x, n - right_wall);
    else if (right_wall == -1)  ans += min(n - x - 1, left_wall + 1);
    else  ans += max(min(x, n - right_wall), min(n - x - 1, left_wall + 1));
    cout << ans << '
';
    return;
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
 
    int t = 1;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}